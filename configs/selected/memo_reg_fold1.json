{
  "name": "memo_reg_fold1",
  "dataset": "memo",
  "model": {
    "mel_bins": 128,
    "second_bins": 84,
    "frames": 87,
    "channels": 128,
    "dim": 128,
    "proj_dim": 64,
    "dropout": 0.1,
    "drop_path": 0.1,
    "envelope": true,
    "prototypes_per_class": 8,
    "activation": "cosine_kernel",
    "tau_initial": 0.1,
    "lambda_initial": 0.5,
    "time_scales": [
      0,
      4,
      16
    ],
    "glance": true,
    "glance_tau": 0.5,
    "residual": false,
    "residual_cap": 1.0,
    "readout_init": 0.1,
    "views": "both",
    "task": "regression"
  },
  "train": {
    "lr": 0.0003,
    "lr_readout": 0.0014999999999999998,
    "weight_decay": 0.001,
    "song_batch": 4,
    "epochs_warm": 3,
    "epochs_joint": 24,
    "snapshot_cycles": 3,
    "patience": 8,
    "epochs_last": 10,
    "label_sigma": 0.1,
    "isda_strength": 0.0,
    "w_cluster": 0.4,
    "w_separation": 0.08,
    "w_diversity": 0.1,
    "w_l1": 0.0001,
    "spec_freq_mask": 12,
    "spec_time_mask": 6,
    "curriculum_fraction": 0.0,
    "curriculum_initial_pool": 4,
    "dev_fraction": 0.1,
    "select_on": "mean",
    "self_distill": false,
    "distill_weight": 0.5,
    "grad_clip": 1.0,
    "w_variance": 1.0,
    "push_after_epochs": 0
  }
}
